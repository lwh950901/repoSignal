---
import type { ProjectRecord } from "../lib/digests";

interface Props {
  project: ProjectRecord;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="project-entry" id={project.id}>
  <div class="project-entry__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
  <div class="project-entry__content">
    <header class="project-heading">
      <div>
        <span class:list={["project-stamp", `project-stamp--${project.kind}`]}>{project.kind}</span>
        <h2><a href={project.url} target="_blank" rel="noreferrer">{project.repository}</a></h2>
      </div>
      {project.score ? (
        <div class="project-score" aria-label={`推荐评分 ${project.score}/100`}>
          <strong>{project.score}</strong>
          <span>/ 100</span>
        </div>
      ) : (
        <div class="project-score project-score--selection" aria-label="周选项目">
          <span class="project-selection">周选</span>
        </div>
      )}
    </header>
    {project.positioning && <p class="project-positioning">{project.positioning}</p>}
    {project.introduction && <p class="project-introduction">{project.introduction}</p>}
    <dl class="project-facts">
      {project.technologies.length > 0 && (
        <div>
          <dt>技术栈</dt>
          <dd>{project.technologies.map((technology) => <span>{technology}</span>)}</dd>
        </div>
      )}
      {project.risk && (
        <div>
          <dt>观察风险</dt>
          <dd>{project.risk}</dd>
        </div>
      )}
      {project.recommendation && (
        <div>
          <dt>为什么推荐</dt>
          <dd>{project.recommendation}</dd>
        </div>
      )}
    </dl>
    <details class="project-details">
      <summary>查看完整分析</summary>
      <div class="prose" set:html={project.html}></div>
    </details>
  </div>
</article>
