---
import ArchiveTimeline from "./ArchiveTimeline.astro";

interface ArchiveReport { slug: string; date: string }
interface Props {
  reports: ArchiveReport[];
  period: "weekly" | "daily" | "feasibility" | "radar";
  currentSlug: string;
}

const { reports, period, currentSlug } = Astro.props;
const periodMeta = {
  weekly: { archiveLabel: "周报", eyebrow: "WEEKLY" },
  daily: { archiveLabel: "日报", eyebrow: "DAILY" },
  feasibility: { archiveLabel: "可行性方案", eyebrow: "FEASIBILITY" },
  radar: { archiveLabel: "开源雷达周刊", eyebrow: "RADAR" },
} as const;
const { archiveLabel, eyebrow } = periodMeta[period];
const href = (slug: string) => `/${period}/${slug}/`;
const archiveItems = reports.map((report) => ({
  label: period === "daily" || period === "feasibility" ? report.date : report.slug,
  href: href(report.slug),
  current: report.slug === currentSlug,
}));
const optionLabel = (report: ArchiveReport) => period === "weekly"
  ? `${report.slug} 周精选`
  : period === "radar" ? `${report.slug} 开源雷达周刊` : report.date;
---

<aside class="date-rail" aria-label={`${archiveLabel}归档`}>
  <div class="archive-rail__header">
    <div class="date-rail__heading">
      <span>{eyebrow}</span>
      <span>{reports.length} 期</span>
    </div>
    <button class="archive-rail-toggle" type="button" data-archive-rail-toggle data-archive-label={archiveLabel} aria-expanded="true" aria-label={`收起${archiveLabel}归档`}>
      <span data-archive-rail-icon aria-hidden="true">←</span>
    </button>
  </div>
  <label class="report-select">
    <span>选择报告</span>
    <select data-report-select>
      {reports.map((report) => (
        <option value={href(report.slug)} selected={report.slug === currentSlug}>{optionLabel(report)}</option>
      ))}
    </select>
  </label>
  <ArchiveTimeline items={archiveItems} />
  <noscript><div class="archive-links">{reports.map((report) => <a href={href(report.slug)}>{period === "daily" || period === "feasibility" ? report.date : report.slug}</a>)}</div></noscript>
</aside>
