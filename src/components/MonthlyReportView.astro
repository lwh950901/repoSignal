---
import type { MonthlyReport } from "../lib/monthly";
interface Props { report: MonthlyReport; months: MonthlyReport[] }
const { report, months } = Astro.props;
const adjacent = months.filter((item) => item.slug !== report.slug);
---

<main id="main-content" class="archive-shell monthly-shell">
  <aside class="date-rail monthly-rail" aria-label="月度归档">
    <div class="date-rail__heading"><span>MONTHLY</span><span>{months.length} 期</span></div>
    <label class="report-select"><span>选择月份</span><select data-report-select>{months.map((item) => <option value={`/monthly/${item.slug}/`} selected={item.slug === report.slug}>{item.slug}</option>)}</select></label>
    <div class="weekly-links">{months.map((item) => <a class:list={{ active: item.slug === report.slug }} href={`/monthly/${item.slug}/`}>{item.slug}</a>)}</div>
    <noscript><div class="weekly-links">{months.map((item) => <a href={`/monthly/${item.slug}/`}>{item.slug}</a>)}</div></noscript>
  </aside>
  <article class="report monthly-report">
    <header class="report-hero">
      <div class="report-kicker"><span>MONTHLY SELECTION</span><time datetime={report.cutoffDate}>数据截止 {report.cutoffDate}</time></div>
      <h1>{report.theme}</h1>
      <div class="report-intro prose" set:html={report.conclusionHtml}></div>
      <div class="report-ledger"><span><strong>{report.candidateCount}</strong> 候选</span><span><strong>5</strong> Top 5</span><span><strong>{report.recommendations.length}</strong> 推荐</span><span><strong>{report.signals.length}</strong> 信号</span></div>
    </header>
    <section class="monthly-section"><h2>三句话读懂这个月</h2><ol>{report.theses.map((thesis) => <li>{thesis}</li>)}</ol></section>
    <section class="monthly-section"><h2>Top 5</h2><div class="project-list">{report.topProjects.map((project, index) => <article class="project-entry" id={project.id}><span class="project-entry__index">0{index + 1}</span><div><h3><a href={project.url}>{project.repository}</a></h3><p>{project.selectionReason}</p><dl class="project-facts"><div><dt>主要角色</dt><dd>{project.primaryAudience}</dd></div><div><dt>最佳场景</dt><dd>{project.bestUseCase}</dd></div><div><dt>主要风险</dt><dd>{project.risk}</dd></div></dl></div></article>)}</div></section>
    <section class="monthly-section"><h2>场景选型</h2><div class="monthly-columns">{["独立开发者", "技术负责人", "AI 产品创业者"].map((audience) => <section><h3>{audience}</h3>{report.recommendations.filter((item) => item.audience === audience).map((item) => <article id={item.id}><a href={item.url}>{item.repository}</a><p>{item.reason}</p><small>风险：{item.risk}</small></article>)}</section>)}</div></section>
    <section class="monthly-section"><h2>RepoSignal 本月观察信号</h2>{report.signals.map((signal) => <article><h3>{signal.direction}：{signal.title}</h3><p>{signal.observation}</p><small>{signal.evidenceStrength} · {signal.supportingRepositories.join("、")}</small></article>)}</section>
    <section class="monthly-section"><h2>行动建议</h2><div class="monthly-columns">{report.actions.map((group) => <section><h3>{group.audience}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}</div></section>
    <nav class="adjacent-links" aria-label="相邻月份">{adjacent.map((item) => <a href={`/monthly/${item.slug}/`}>{item.slug}</a>)}</nav>
  </article>
</main>

<script>document.querySelector<HTMLSelectElement>("[data-report-select]")?.addEventListener("change", (event) => { window.location.href = (event.currentTarget as HTMLSelectElement).value; });</script>
