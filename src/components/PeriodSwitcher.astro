---
import type { ReportPeriod } from "../lib/periods";
interface Props { active: ReportPeriod; links: Record<ReportPeriod, string> }
const { active, links } = Astro.props;
const labels: Record<ReportPeriod, string> = { monthly: "月度洞察", weekly: "每周精选", daily: "每日发现", radar: "开源雷达周刊" };
---

<nav class="period-switcher" aria-label="报告周期">
  {(["monthly", "weekly", "daily", "radar"] as const).map((period) => (
    <a href={links[period]} aria-current={active === period ? "true" : undefined}>{labels[period]}</a>
  ))}
</nav>
