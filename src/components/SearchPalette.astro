---
import type { SearchItem } from "../lib/search";

interface Props { items: SearchItem[] }
const { items } = Astro.props;
---

<dialog class="search-palette" data-search-dialog data-items={JSON.stringify(items)} aria-labelledby="search-title">
  <div class="search-palette__bar">
    <label for="project-search" id="search-title">搜索项目</label>
    <input id="project-search" data-search-input type="search" placeholder="仓库、技术栈或使用场景…" autocomplete="off" />
    <button type="button" data-search-close aria-label="关闭搜索">Esc</button>
  </div>
  <div class="search-palette__meta" aria-live="polite" data-search-meta>最近发现</div>
  <div class="search-results" data-search-results role="listbox" aria-label="搜索结果"></div>
</dialog>

<script is:inline src="/scripts/search-palette.js" defer></script>
