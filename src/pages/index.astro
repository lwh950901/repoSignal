---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReportView from "../components/ReportView.astro";
import { createSearchIndex, loadDailyReports, loadWeeklyReports, selectDefaultReport } from "../lib/digests";
import { createMonthlySearchIndex, loadMonthlyReports } from "../lib/monthly";
import { loadFeasibilityReports } from "../lib/feasibility";
import { resolvePeriodLinks } from "../lib/periods";
import { loadRadarReports } from "../lib/radar";

const dailyReports = loadDailyReports();
const weeklyReports = loadWeeklyReports();
const monthlyReports = loadMonthlyReports();
const feasibilityReports = loadFeasibilityReports();
const radarReports = loadRadarReports();
const report = selectDefaultReport(dailyReports, weeklyReports);
const searchItems = [...createMonthlySearchIndex(monthlyReports), ...createSearchIndex([...weeklyReports, ...dailyReports])];
const periodLinks = report ? resolvePeriodLinks(report.type, report.slug, monthlyReports.map((item) => item.slug), weeklyReports.map((item) => item.slug), dailyReports.map((item) => item.slug), feasibilityReports.map((item) => item.slug), radarReports.map((item) => item.slug)) : { monthly: "/monthly/", weekly: "/weekly/", daily: "/daily/", feasibility: "/feasibility/", radar: "/radar/" };
---

<BaseLayout title="RepoSignal｜GitHub 优质项目" searchItems={searchItems} activePeriod={report?.type ?? "weekly"} periodLinks={periodLinks}>
  {report ? (
    <ReportView report={report} reports={report.type === "daily" ? dailyReports : weeklyReports} />
  ) : (
    <main id="main-content" class="empty-state empty-state--page">
      <h1>还没有项目报告</h1>
      <p>将 Markdown 放入 <code>data/github-project-digest/daily</code> 后重新构建。</p>
    </main>
  )}
</BaseLayout>
