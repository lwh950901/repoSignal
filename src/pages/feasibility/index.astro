---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createSearchIndex, loadDailyReports, loadWeeklyReports } from "../../lib/digests";
import { loadFeasibilityReports } from "../../lib/feasibility";
import { createMonthlySearchIndex, loadMonthlyReports } from "../../lib/monthly";
import { resolvePeriodLinks } from "../../lib/periods";
import { loadRadarReports } from "../../lib/radar";

const monthlyReports = loadMonthlyReports();
const weeklyReports = loadWeeklyReports();
const dailyReports = loadDailyReports();
const feasibilityReports = loadFeasibilityReports();
const radarReports = loadRadarReports();
const latest = feasibilityReports[0];
const searchItems = [...createMonthlySearchIndex(monthlyReports), ...createSearchIndex([...weeklyReports, ...dailyReports])];
const periodLinks = resolvePeriodLinks("feasibility", latest?.slug ?? "", monthlyReports.map((item) => item.slug), weeklyReports.map((item) => item.slug), dailyReports.map((item) => item.slug), feasibilityReports.map((item) => item.slug), radarReports.map((item) => item.slug));
---

<BaseLayout title="每日可行性方案归档｜RepoSignal" description="基于近期 GitHub 项目发现生成的每日组合可行性研究草稿。" canonical="/feasibility/" searchItems={searchItems} activePeriod="feasibility" periodLinks={periodLinks}>
  <main id="main-content" class="empty-state empty-state--page">
    <h1>每日可行性方案</h1>
    {latest ? <a href={`/feasibility/${latest.slug}/`}>打开最新方案 {latest.slug}</a> : <p>暂时没有每日可行性方案。</p>}
  </main>
</BaseLayout>
