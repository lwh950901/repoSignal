---
import BaseLayout from "../../layouts/BaseLayout.astro"; import { createSearchIndex, loadDailyReports, loadWeeklyReports } from "../../lib/digests"; import { createMonthlySearchIndex, loadMonthlyReports } from "../../lib/monthly";
const weekly = loadWeeklyReports(); const daily = loadDailyReports(); const monthly = loadMonthlyReports(); const items = [...createMonthlySearchIndex(monthly), ...createSearchIndex([...weekly, ...daily])]; const links = { monthly: monthly[0] ? `/monthly/${monthly[0].slug}/` : "/monthly/", weekly: weekly[0] ? `/weekly/${weekly[0].slug}/` : "/weekly/", daily: daily[0] ? `/daily/${daily[0].slug}/` : "/daily/" };
---
<BaseLayout title="周报归档｜RepoSignal" searchItems={items} activePeriod="weekly" periodLinks={links}><main id="main-content" class="empty-state empty-state--page"><h1>周报归档</h1>{weekly.length ? <a href={`/weekly/${weekly[0].slug}/`}>打开最新周报 {weekly[0].slug}</a> : <p>暂时没有周报。</p>}</main></BaseLayout>
